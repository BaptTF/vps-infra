#!/usr/bin/env python3
"""tailnet-nc HOST PORT: pipe stdin/stdout to HOST:PORT through the Tailscale sidecar SOCKS5 (ssh ProxyCommand)."""

import os
import selectors
import socket
import struct
import sys

SOCKS = ("127.0.0.1", 1055)


def recv_exact(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            sys.exit("tailnet-nc: SOCKS5 proxy closed the connection")
        buf += chunk
    return buf


host, port = sys.argv[1], int(sys.argv[2])
s = socket.create_connection(SOCKS, 10)
s.sendall(b"\x05\x01\x00")
recv_exact(s, 2)
s.sendall(b"\x05\x01\x00\x03" + bytes([len(host)]) + host.encode() + struct.pack("!H", port))
ver, rep, _, atyp = recv_exact(s, 4)
if rep != 0:
    sys.exit(f"tailnet-nc: SOCKS5 error {rep} for {host}:{port}")
recv_exact(s, (recv_exact(s, 1)[0] if atyp == 3 else {1: 4, 4: 16}[atyp]) + 2)
s.settimeout(None)

sel = selectors.DefaultSelector()
sel.register(0, selectors.EVENT_READ)
sel.register(s, selectors.EVENT_READ)
while True:
    for key, _ in sel.select():
        if key.fileobj == 0:
            data = os.read(0, 65536)
            if not data:
                s.shutdown(socket.SHUT_WR)
                sel.unregister(0)
                continue
            s.sendall(data)
        else:
            data = s.recv(65536)
            if not data:
                sys.exit(0)
            os.write(1, data)
